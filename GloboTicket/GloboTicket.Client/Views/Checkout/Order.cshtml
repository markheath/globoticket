@model GloboTicket.Web.Models.View.OrderResultViewModel
@{
    var confirmed = Model.Status == "Confirmed";
    var failed = Model.Status == "Failed";
}

<h2 class="mb-2">Order @Model.OrderId.ToString().Substring(0, 8)</h2>

@if (confirmed)
{
    <div class="workflow-result success">
        Order complete. Your tickets are on their way and a confirmation email has been sent.
    </div>
}
else if (failed)
{
    <div class="workflow-result failure">
        Order failed: @Model.FailureReason
    </div>
}
else
{
    <div class="workflow-result">
        Order status: @Model.Status
    </div>
}

<div class="mt-4">
    <a class="btn btn-primary" asp-controller="EventCatalog" asp-action="Index">BACK TO EVENTS</a>
</div>
