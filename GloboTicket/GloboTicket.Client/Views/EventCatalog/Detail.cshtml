@model GloboTicket.Web.Models.Api.Event
<div class="row mt-5">
    <div class="col-md-4">
        <img src="@Model.ImageUrl" class="detailImage" alt="Artist pic" />
    </div>
    <div class="col-md-6 ms-1">
        <div class="columnHeader">@Model.CategoryName.ToUpper()</div>
        <h1 class="mt-2 bold">@Model.Name</h1>
        <h3 class="mt-2">@Model.Artist</h3>
        <h3 class="mt-4 bold">@Model.Date.ToShortDateString()</h3>
        <div class="mt-4">@Model.Description</div>
        <div class="mt-5 d-flex align-items-baseline">
            <h3 class="bold mb-0">$@Model.Price</h3>
            <span class="ms-3">PER TICKET</span>
        </div>
    </div>
</div>
<hr class="mt-5" />
<div class="row mt-4">
    <div class="col-md-8 offset-md-4">
        <form asp-action="AddLine" asp-controller="ShoppingBasket" class="d-flex align-items-center">
            <label class="columnHeader">QUANTITY:</label>
            <select name="TicketAmount" class="ms-3">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </select>
            <input asp-for="EventId" type="hidden" />
            <input asp-for="Price" type="hidden" />
            <button type="submit" class="btn btn-primary ms-4">PLACE ORDER</button>
        </form>
    </div>
</div>
